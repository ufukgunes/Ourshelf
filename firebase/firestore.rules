rules_version = '2';

// Ourshelf — Firestore güvenlik kuralları.
// Kişisel kütüphane cihazdadır; buluta yalnızca paylaşılan raflar gelir.
//
// İlkeler
// - Raf KURMAK yalnızca Ourshelf+ abonelerine açıktır (users/{uid}.plus == true; bu alanı yalnızca sunucu yazar).
// - Rafa KATILMAK ücretsizdir ama geçerli ve süresi dolmamış bir davet kodu gerektirir.
// - Bir rafın içeriğini yalnızca üyeleri okuyup yazabilir.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Not: Kurallarda olmayan bir belgeye get() değerlendirmeyi hataya düşürür; önce exists() kontrol edilir.
    function isPlus() {
      let path = /databases/$(database)/documents/users/$(uid());
      return exists(path) && get(path).data.get('plus', false) == true;
    }

    function shelf(shelfId) {
      return get(/databases/$(database)/documents/shelves/$(shelfId));
    }

    function isMember(shelfId) {
      return signedIn() && uid() in shelf(shelfId).data.memberUids;
    }

    function validName(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    // Değişen alanlar yalnızca izin verilenler mi?
    function onlyChanges(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ---- Kullanıcılar --------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if signedIn() && uid() == userId;
      // Oluştururken "plus" yazılamaz.
      allow create: if signedIn() && uid() == userId
        && request.resource.data.keys().hasOnly(['displayName', 'createdAt'])
        && validName(request.resource.data.displayName);
      // Yalnızca görünen ad değişebilir; "plus" sunucuya (RevenueCat eklentisi) aittir.
      allow update: if signedIn() && uid() == userId
        && onlyChanges(['displayName'])
        && validName(request.resource.data.displayName);
      allow delete: if false;
    }

    // ---- Davetler -------------------------------------------------------------------------------
    // Belge kimliği tahmin edilemez davet kodudur. Kodu bilen tek bir daveti okuyabilir; listeleme yasak.
    match /invites/{token} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && isMember(request.resource.data.shelfId)
        && request.resource.data.createdBy == uid()
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt < request.time + duration.value(31, 'd');
      allow delete: if signedIn() && resource.data.createdBy == uid();
      allow update: if false;
    }

    // ---- Raflar ---------------------------------------------------------------------------------
    match /shelves/{shelfId} {
      allow read: if signedIn() && uid() in resource.data.memberUids;

      // Kurmak: yalnızca Ourshelf+; kurucu tek üye olarak başlar.
      allow create: if signedIn() && isPlus()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.memberUids == [uid()]
        && request.resource.data.memberNames.keys().hasOnly([uid()])
        && validName(request.resource.data.name);

      // Üyeler ad/emoji değiştirebilir; sahip üye çıkarabilir.
      allow update: if signedIn() && uid() in resource.data.memberUids && (
          onlyChanges(['name', 'emoji', 'updatedAt'])
          || (uid() == resource.data.ownerUid && onlyChanges(['memberUids', 'memberNames', 'updatedAt'])
              && request.resource.data.memberUids.hasAll([resource.data.ownerUid])
              && resource.data.memberUids.hasAll(request.resource.data.memberUids))
          || isLeaving()
        )
        || isJoining();

      // Ayrılmak: üye yalnızca kendini çıkarabilir (sahip ayrılamaz, rafı silmelidir).
      function isLeaving() {
        return uid() != resource.data.ownerUid
          && onlyChanges(['memberUids', 'memberNames', 'updatedAt'])
          && request.resource.data.memberUids == resource.data.memberUids.removeAll([uid()])
          && !(uid() in request.resource.data.memberNames);
      }

      // Katılmak: geçerli davet koduyla yalnızca kendini ekler; en fazla 10 üye.
      function isJoining() {
        let invitePath = /databases/$(database)/documents/invites/$(request.resource.data.get('joinToken', '-'));
        return signedIn()
          && !(uid() in resource.data.memberUids)
          && onlyChanges(['memberUids', 'memberNames', 'joinToken', 'updatedAt'])
          && request.resource.data.memberUids == resource.data.memberUids.concat([uid()])
          && request.resource.data.memberUids.size() <= 10
          && validName(request.resource.data.memberNames[uid()])
          && exists(invitePath)
          && get(invitePath).data.shelfId == shelfId
          && get(invitePath).data.expiresAt > request.time;
      }

      allow delete: if signedIn() && uid() == resource.data.ownerUid;

      // ---- Raftaki eserler --------------------------------------------------------------------
      match /items/{itemId} {
        allow read: if isMember(shelfId);
        allow create: if isMember(shelfId)
          && request.resource.data.addedBy == uid()
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 300;
        // Herkes oy verip bitirebilir; ekleyen kişi ve eser kimliği değişmez.
        allow update: if isMember(shelfId)
          && request.resource.data.addedBy == resource.data.addedBy
          && request.resource.data.externalId == resource.data.externalId
          && votesOnlyOwn()
          && completionsOnlyOwn();
        allow delete: if isMember(shelfId);

        // Oy ve "bitirdim" alanlarında herkes yalnızca kendi anahtarını değiştirebilir.
        function votesOnlyOwn() {
          let before = resource.data.get('votes', {});
          let after = request.resource.data.get('votes', {});
          return after.diff(before).affectedKeys().hasOnly([uid()]);
        }
        function completionsOnlyOwn() {
          let before = resource.data.get('completedBy', {});
          let after = request.resource.data.get('completedBy', {});
          return after.diff(before).affectedKeys().hasOnly([uid()]);
        }
      }

      // ---- Aktivite akışı ---------------------------------------------------------------------
      match /activity/{eventId} {
        allow read: if isMember(shelfId);
        allow create: if isMember(shelfId) && request.resource.data.actorUid == uid();
        allow update, delete: if false;
      }
    }
  }
}
